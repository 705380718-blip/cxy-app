WML_PLATFORM=windows
WML_HOST=127.0.0.1
WML_PORT=8791
WML_GROUPS=请在后台填写群名
WML_SELF_NAMES=我
WML_POLL_INTERVAL=0.5
WML_ALLOW_UNVERIFIED_DECODER=false

# 多账号时必须填写账号目录名；程序不会自动合并。
WML_WINDOWS_ACCOUNT_ID=

# 自动发现失败时再填写以下两项。
# WML_WECHAT_APP=C:\Program Files\Tencent\WeChat\WeChat.exe
# WML_WECHAT_DATA_ROOT=C:\Users\{{当前用户}}\Documents\xwechat_files

