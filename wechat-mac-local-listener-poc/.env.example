WML_HOST=127.0.0.1
WML_PORT=8791
WML_DATABASE_PATH=~/Library/Application Support/群聊问题整理/data/mac-listener.db
WML_GROUPS=请在后台填写群名
WML_SELF_NAMES=我
WML_POLL_INTERVAL=0.5
WML_MAX_VERIFIED_WECHAT_VERSION=4.1.12
WML_ALLOW_UNVERIFIED_DECODER=false

# 一般无需填写：程序会自动发现官方微信容器、唯一账号目录和 ~/.config/wechat-keys.json。
# 多账号或自定义目录时，请按使用手册配置 WML_WECHAT_DATA_ROOT 与 WML_DECODER_COMMAND。
